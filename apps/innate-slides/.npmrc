# Registry mirror for faster downloads in China.
registry=https://registry.npmmirror.com/

# pnpm 12 在每次脚本前做依赖预检；本项目存在被忽略的构建脚本
# （@scarf/scarf / esbuild 的 postinstall，均为无害项），预检安装会以
# 非零退出导致每个脚本前都打印 WARN，这里关闭预检。
verify-deps-before-run=false

# 显式忽略这两个包的构建脚本（无实际需要：esbuild 走平台 optionalDependencies 直装）
ignored-built-dependencies[]=@scarf/scarf
ignored-built-dependencies[]=esbuild
strict-dep-builds=false
