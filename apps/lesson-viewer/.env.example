# =============================================================================
#  AI 助教（底部对话区）— Anthropic-compatible 多 Provider
#
#  与 learn-workbuddy 教程同一套 provider 模型：任何 Anthropic 兼容端点
#  换 BASE_URL + MODEL_ID 即可切换。不填 ANTHROPIC_API_KEY 时进入离线模式
#  （页面可正常使用，AI 助教显示引导文案，不发任何请求）。
#
#  Provider         MODEL_ID            Base URL
#  ---------------  ------------------  ---------------------------------
#  Anthropic        claude-sonnet-4-6   （默认，不填 BASE_URL）
#  GLM (Zhipu)      glm-5               https://api.z.ai/api/anthropic
#  DeepSeek         deepseek-v4-pro     https://api.deepseek.com/anthropic
#  Kimi (Moonshot)  kimi-k2.5           https://platform.moonshot.ai/anthropic
#  MiniMax          MiniMax-M2.5        https://api.minimax.io/anthropic
# =============================================================================

# ---- 方式一：Anthropic 官方 ----
ANTHROPIC_API_KEY=
MODEL_ID=claude-sonnet-4-6

# ---- 方式二：GLM / DeepSeek / Kimi（任选其一，取消注释）----
# ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
# MODEL_ID=glm-5
# ANTHROPIC_API_KEY=your-key

# ---- 课程内容源（build-content 脚本读取）----
# 默认取 monorepo 根目录 learn-workbuddy，可按需覆盖
# LESSON_SOURCE=D:\path\to\learn-workbuddy
