{
  "name": "lwb-player",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "node scripts/build-slides.mjs --if-missing && node scripts/build-decks.mjs --if-missing && next dev --port 4013",
    "dev:next": "next dev --port 4013",
    "build": "node scripts/build-slides.mjs && node scripts/build-decks.mjs && next build",
    "start": "next start --port 4013",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "content:build": "tsx scripts/build-content.ts",
    "slides:build": "node scripts/build-slides.mjs",
    "decks:build": "node scripts/build-decks.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@copilotkit/react-core": "^1.79.0",
    "@copilotkit/react-ui": "^1.79.0",
    "@copilotkit/runtime": "^1.79.0",
    "@innate/ui": "file:../../../framework/innate-fe/packages/ui",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "next": "^16.2.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@slidev/cli": "^53.0.0",
    "@slidev/theme-default": "^0.25.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "oxlint": "^1.88.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.20.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
